{
  "name": "BankTransfer",
  "type": "object",
  "properties": {
    "donor_name": {
      "type": "string",
      "maxLength": 60
    },
    "amount": {
      "type": "number",
      "minimum": 1,
      "maximum": 10000000
    },
    "reference": {
      "type": "string",
      "default": "",
      "maxLength": 40
    },
    "contact": {
      "type": "string",
      "default": "",
      "maxLength": 60
    },
    "message": {
      "type": "string",
      "default": "",
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "default": "pending"
    }
  },
  "required": [
    "donor_name",
    "amount"
  ],
  "rls": {
    "create": true,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}