{
  "name": "Donation",
  "type": "object",
  "properties": {
    "donor_name": {
      "type": "string",
      "maxLength": 60
    },
    "amount": {
      "type": "number",
      "minimum": 1,
      "maximum": 10000000
    },
    "frequency": {
      "type": "string",
      "enum": [
        "one_time",
        "monthly"
      ],
      "default": "one_time"
    },
    "message": {
      "type": "string",
      "default": "",
      "maxLength": 200
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "donor_name",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}