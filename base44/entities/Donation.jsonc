{
  "name": "Donation",
  "type": "object",
  "properties": {
    "donor_name": {
      "type": "string",
      "description": "Name shown on the donor wall. Empty for anonymous gifts."
    },
    "amount": {
      "type": "number",
      "description": "Donation amount in INR"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "one_time",
        "monthly"
      ],
      "default": "one_time"
    },
    "message": {
      "type": "string",
      "description": "Optional message of love for the elders"
    },
    "anonymous": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "amount",
    "frequency"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}