{
  "name": "Notification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "default": ""
    },
    "type": {
      "type": "string",
      "enum": [
        "milestone",
        "story",
        "donation",
        "general"
      ],
      "default": "general"
    },
    "link": {
      "type": "string",
      "default": ""
    },
    "pushed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this was sent as a push alert"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}