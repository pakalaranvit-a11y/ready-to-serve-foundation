{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "BankTransfer"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "screen_new_payment_reports",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "screen": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "screenPaymentReport",
            "args": {
              "id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Check for spam",
            "description": "Delete junk reports"
          }
        }
      }
    ]
  },
  "name": "Screen New Payment Reports",
  "description": "Removes spam, links and repeat or duplicate payment reports as soon as they arrive"
}